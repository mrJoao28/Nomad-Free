// NomadFree — estações de esqui.
// Favoritos NÃO têm modelo aqui: nesta fase são locais ao navegador (localStorage).

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
  previewFeatures = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tag {
  FAMILY
  BEGINNERS
  ADVANCED
  FREERIDE
  LARGE_AREA
  HIGH_ALTITUDE
  APRES_SKI
  LUXURY
  BUDGET
  PARK
}

enum Region {
  ALPS
  EUROPE_OTHER
  NORTH_AMERICA
  ASIA
  SOUTH_AMERICA
  OCEANIA
}

/// ESTIMATE = valor ilustrativo/estimado. VERIFIED = conferido em fonte oficial (com data em verifiedAt).
enum PriceKind {
  ESTIMATE
  VERIFIED
}

model Resort {
  id               String     @id @default(cuid())
  slug             String     @unique
  name             String
  country          String
  region           Region
  /// Cadeia de montanhas ou região (texto livre, ex.: "Alpes Penninos").
  mountainRange    String
  tags             Tag[]
  summary          String
  description      String
  /// Posição na curadoria NomadFree (1 = primeira). Não é um ranking medido.
  curatedRank      Int
  /// Altitude máxima aproximada, em metros.
  topElevationM    Int
  /// Texto exibido, ex.: "≈ 360 km de pistas (com Cervinia)".
  areaLabel        String
  /// Tamanho relativo de 1 (compacta) a 5 (gigante), usado em filtros e ordenação.
  sizeRank         Int
  /// Temporada típica, ex.: "Dez–Abr".
  seasonLabel      String
  /// Custo diário estimado por pessoa em centavos (lift pass, hospedagem e refeições).
  dailyBudgetMinor Int
  currency         String     @default("BRL") @db.VarChar(3)
  priceKind        PriceKind  @default(ESTIMATE)
  verifiedAt       DateTime?
  sourceLabel      String
  imageKey         String
  isDemo           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([region])
  @@index([country])
  @@index([curatedRank])
  @@index([dailyBudgetMinor])
}
