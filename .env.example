# Copie para .env e ajuste. NUNCA faça commit do .env real.
# Valores abaixo são apenas placeholders de desenvolvimento local.

POSTGRES_USER=nomadfree
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nomadfree
POSTGRES_TEST_DB=nomadfree_test

# Porta exposta SOMENTE em 127.0.0.1 para ferramentas locais (Prisma Studio, testes no host).
DB_HOST_PORT=5432

# Usada ao rodar a aplicação/CLI no host (fora do Docker). Dentro do Compose o host é "db".
DATABASE_URL=postgresql://nomadfree:change-me-local-only@localhost:5432/nomadfree?schema=public

# Banco ISOLADO para testes de integração e E2E. O nome DEVE terminar em "_test".
TEST_DATABASE_URL=postgresql://nomadfree:change-me-local-only@localhost:5432/nomadfree_test?schema=public

# URL pública do site (metadados/Open Graph). Opcional.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
